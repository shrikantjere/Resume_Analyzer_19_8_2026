# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3
OPENAI_RETRY_COUNT=3
OPENAI_TIMEOUT=30

# Database
DATABASE_URL=sqlite:///data/analyzer.db

# Application
MAX_FILE_SIZE_MB=10
LOG_LEVEL=INFO
LOG_FORMAT=json
UPLOAD_DIR=data/uploads
REPORT_DIR=data/reports
JOB_DB_PATH=data/job_database.json
JOB_CACHE_TTL_HOURS=24
MAX_ANALYSIS_PER_SESSION=10